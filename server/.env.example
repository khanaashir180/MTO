PORT=4000
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=replace_with_secure_secret_at_least_24_chars
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mto
UPLOAD_DIR=uploads
LOG_LEVEL=info
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=40
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=800
METRICS_ENABLED=true
METRICS_TOKEN=replace_with_metrics_token
# Optional malware scanning integration
# CLAMSCAN_PATH=C:\Program Files\ClamAV\clamscan.exe
# CLAMSCAN_TIMEOUT_MS=12000
