# Copy this file to `.env.production` before your first production deployment.
# Use strong, unique secrets. Do not commit the real file.

POSTGRES_DB=mto
POSTGRES_USER=mto_app
POSTGRES_PASSWORD=replace_with_a_very_long_database_password

JWT_SECRET=replace_with_a_minimum_32_character_jwt_secret
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d

UPLOAD_DIR=uploads
LOG_LEVEL=info

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=25
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600

METRICS_ENABLED=true
METRICS_TOKEN=replace_with_a_long_metrics_token

APP_DOMAIN=app.example.com
CLIENT_ORIGIN=https://app.example.com
PUBLIC_API_URL=https://app.example.com

# Local-only helper ports. In production compose, public traffic should go through Caddy.
WEB_PORT=3000
API_PORT=4000
POSTGRES_HOST_PORT=5433
