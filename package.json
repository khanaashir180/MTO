{
  "name": "mto",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "axios": "^1.8.2",
    "react": "^19.2.4",
    "react-barcode": "^1.5.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.1.5",
    "socket.io-client": "^4.8.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "vite",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run --passWithNoTests",
    "server:dev": "npm run dev --prefix server",
    "server:start": "npm run start --prefix server",
    "migrate": "npm run migrate --prefix server",
    "seed": "npm run seed --prefix server",
    "railway:build": "npm ci --prefix server",
    "railway:start": "npm run migrate --prefix server && npm run start --prefix server"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.2",
    "typescript": "^4.9.5",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "socket.io-parser": "4.2.6",
    "minimatch": "^3.1.4",
    "@tootallnate/once": "^3.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
